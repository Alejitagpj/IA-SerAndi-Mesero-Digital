# ============================================================================
# Ventum — Variables de entorno
# La app corre 100% en MODO MOCK sin ninguna de estas variables.
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND (build con Vite) — se exponen al navegador (prefijo VITE_)
# ----------------------------------------------------------------------------
# Base del API de coordinación. En producción el frontend lo sirve el mismo
# servidor Express, así que NO hace falta definirla (usa el mismo origen).
# Útil solo en desarrollo para apuntar a un backend local, p. ej:
# VITE_API_URL=http://localhost:3000
VITE_API_URL=

# ============================================================================
# SERVIDOR (Railway) — NUNCA se exponen al navegador
# ============================================================================

# --- PostgreSQL (coordinación entre dispositivos: sesiones y pedidos) ---
# En Railway: agrega un servicio PostgreSQL y referencia su DATABASE_URL.
# Si falta, la app cae a modo mock (localStorage por dispositivo).
DATABASE_URL=

# Pon PGSSL=true solo si tu Postgres exige SSL (URL pública). La conexión
# interna de Railway no lo necesita.
# PGSSL=true

# --- Sheila IA con Google Gemini (proxy seguro) ---
# API key gratis en https://aistudio.google.com/apikey
# Si falta, /api/sheila responde 503 y Sheila usa el motor local determinista.
GEMINI_API_KEY=

# Modelo de Gemini (opcional). Por defecto: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
